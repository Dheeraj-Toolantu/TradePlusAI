# Groww broker settings read by services/execution/src/groww-config.ts.
# Copy the values you need into .env.local. Server-only: never prefix with NEXT_PUBLIC_.
# Never commit real keys, secrets or tokens.

# Authenticate with EITHER an API key + secret pair OR a daily access token.
GROWW_API_KEY=
GROWW_API_SECRET=
# GROWW_ACCESS_TOKEN=

# Optional overrides (defaults shown).
# GROWW_API_BASE_URL=https://api.groww.in
# GROWW_API_VERSION=1.0

# PAPER is the safe default. ALGO_LIVE also needs LIVE_EXECUTION_ENABLED=true and
# LIVE_COMPLIANCE_APPROVED=true (see .env.example for the live-trading limits).
EXECUTION_MODE=PAPER
LIVE_EXECUTION_ENABLED=false
LIVE_COMPLIANCE_APPROVED=false
LIVE_TRADING_CONFIRMATION=false
