NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://tradepulse:tradepulse_local_only@localhost:5432/tradepulse
REDIS_URL=redis://localhost:6379
MARKET_DATA_PROVIDER=yahoo
LIVE_EXECUTION_ENABLED=false

# --- Groww API (server-only; never prefix with NEXT_PUBLIC_) ---
GROWW_API_KEY=
GROWW_API_SECRET=
# GROWW_ACCESS_TOKEN=

# --- Real-money trading: OFF unless ALL of the following are set ---
# Every live order still needs a preview + PIN confirmation in the UI.
# set ALGO_LIVE to arm
EXECUTION_MODE=PAPER
# set true only after broker/SEBI algo requirements are met
LIVE_COMPLIANCE_APPROVED=false
# 6+ characters, asked on every live confirm/exit
LIVE_TRADING_PIN=
# 16+ random characters (keeps confirmations valid across restarts)
LIVE_CONFIRM_SECRET=
# Risk limits (defaults shown)
LIVE_MAX_DAILY_LOSS=2000
LIVE_MAX_TRADES_PER_DAY=3
LIVE_MAX_LOTS_PER_ORDER=1
LIVE_MAX_ORDER_VALUE=25000
LIVE_MAX_OPEN_POSITIONS=1
LIVE_MIN_REWARD_RISK=2
LIVE_LIMIT_BUFFER_PCT=0.5
LIVE_ENTRY_START=09:35
LIVE_ENTRY_END=14:45
LIVE_SQUARE_OFF=15:15
# Emergency controls: ALGO_KILL_SWITCH=true blocks entries AND flattens open live positions.
ALGO_KILL_SWITCH=false
ALGO_SAFE_MODE=false

# --- Sentiment scanner (optional override of the default public feed list) ---
# SENTIMENT_SOURCES_JSON=/path/to/sources.json
# Reddit blocks anonymous bursts ("HTTP Error 403: Blocked"). A free "script" app from
# https://www.reddit.com/prefs/apps gives app-only OAuth access, which is not blocked:
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:tradepulse-sentiment:1.2 (by /u/your_reddit_username)
# Last-good feed cache (served when a live fetch fails, up to 12 h); defaults to the OS temp dir.
# SENTIMENT_CACHE_DIR=

# --- Also required to arm live trading (set true together with the switches above) ---
LIVE_TRADING_CONFIRMATION=false

# --- AI monitoring (LiteLLM gateway) ---
LITELLM_ENDPOINT=
LITELLM_API_KEY=
LITELLM_MODEL=tradepulse-default
AI_MONITORING_TIMEOUT_MS=8000
AI_CHAT_TIMEOUT_MS=60000
